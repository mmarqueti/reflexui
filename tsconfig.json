{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@reflexui-jev/core": [
        "packages/core/src/index.ts"
      ],
      "@reflexui-jev/providers": [
        "packages/providers/src/index.ts"
      ],
      "@reflexui-jev/react": [
        "packages/react/src/index.ts"
      ],
      "@reflexui-jev/replay": [
        "packages/replay/src/index.ts"
      ],
      "@reflexui-jev/redis": [
        "packages/redis/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "examples/*/src"
  ]
}
