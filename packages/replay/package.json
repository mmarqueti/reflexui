{
  "name": "@reflexui-jev/replay",
  "version": "0.1.0",
  "description": "Offline replay over labeled history: hit rate vs default order, latency, cost.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@reflexui-jev/core": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
