  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "reflexui",
    "adaptive-ui",
    "headless",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmarqueti/reflexui.git",
    "directory": "packages/replay"
  },
  "homepage": "https://github.com/mmarqueti/reflexui#readme",
  "bugs": {
    "url": "https://github.com/mmarqueti/reflexui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build"
  }
}
